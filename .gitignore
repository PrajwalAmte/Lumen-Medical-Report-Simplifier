# Root .gitignore for monorepo

# Environment and secrets — never commit these
.env
.env.*
!backend/.env.example

# Node
node_modules/
frontend/dist/

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Training data — large files managed outside git
training/data/
training/__pycache__/

# Docker
.DS_Store
docker-compose.override.yml

# Logs
*.log
lumen-key.pem

# IDE
.vscode/settings.json
.idea/
